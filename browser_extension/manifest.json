{
  "manifest_version": 3,
  "name": "FigAI Tab Bridge",
  "version": "0.1.0",
  "description": "Lets your local FigAI assistant see your open tabs and open a tab when you ask. Talks only to FigAI on this computer (127.0.0.1).",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "FigAI Tab Bridge", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } }
}
