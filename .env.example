# Copy to .env next to this file. Never commit the real .env.
# chmod/icacls it to your user only if your filesystem supports it.

OPENROUTER_API_KEY=replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
# Your Slack user ID (e.g. U01234567). Fig responds ONLY to this user.
ALLOWED_SLACK_USER_ID=U0000000

# One SSH_HOST_<alias> line per configured machine, alias becomes lowercase.
# Format: host=<ip-or-hostname>;user=<username>;port=22;key_path=<path-to-private-key>
# The vault host alias below must match one of these.
SSH_HOST_VAULT=host=192.168.1.10;user=matt;port=22;key_path=C:\Users\matt\.ssh\id_ed25519_vault

# Optional media services (Sonarr / Radarr / SABnzbd). They normally run on the turbo-plex server, not this PC,
# so 127.0.0.1 is WRONG unless they run here. Easiest: put turbo-plex's address in MEDIA_HOST and set just the
# three API keys (each service: Settings -> General -> API key; SABnzbd: Config -> General). The URLs are then
# http://<MEDIA_HOST>:8989 / :7878 / :8080. Set a service's own *_URL line to override the address or port.
# MEDIA_HOST=192.168.50.51
# SONARR_API_KEY=replace-me
# RADARR_API_KEY=replace-me
# SABNZBD_API_KEY=replace-me
# SONARR_URL=http://192.168.50.51:8989
# RADARR_URL=http://192.168.50.51:7878
# SABNZBD_URL=http://192.168.50.51:8080

# Optional: OBS control (recording/streaming/scenes) via OBS WebSocket
# (Tools > WebSocket Server Settings in OBS 28+). Leave OBS_WS_HOST unset to disable.
# OBS_WS_HOST=127.0.0.1
# OBS_WS_PORT=4455
# OBS_WS_PASSWORD=replace-me

# Optional: GitHub token (read-only is enough) so Fig can tell you which PR/label an
# update applied, if the repo is private. Not needed for a public repo.
# GITHUB_TOKEN=replace-me

# Optional: shared secret for the Chrome tab-bridge extension (browser_extension/).
# At least 16 characters; the bridge is off if unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# BROWSER_BRIDGE_TOKEN=replace-me

# Optional: read-only Gmail summaries. Needs 2-Step Verification on the account; create an
# app password at https://myaccount.google.com/apppasswords (spaces are fine). Fig only reads
# (never marks read, sends, moves, or deletes). Note: email text you ask about is sent to
# your OpenRouter model -- prefer a model/provider that doesn't log or train on prompts.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
