{
  "name": "figai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "build:mac:arm64": "bun scripts/build.ts darwin-arm64",
    "build:mac:x64": "bun scripts/build.ts darwin-x64",
    "build:linux:arm64": "bun scripts/build.ts linux-arm64",
    "build:linux:x64": "bun scripts/build.ts linux-x64",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "test": "bun test --timeout 10000",
    "test:smoke": "RUN_SMOKE_TESTS=1 bun test test/smoke"
  },
  "dependencies": {
    "@slack/bolt": "4.7.3",
    "dotenv": "17.4.2",
    "luxon": "3.7.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.3.14",
    "@types/luxon": "3.7.5",
    "typescript": "5.9.3"
  }
}
