# macOS: copy to ~/Library/Application Support/FigAi/.env and chmod 600 it.
# Linux: copy to ~/.config/figai/.env and chmod 600 it.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
OPENROUTER_API_KEY=replace-me
OWNER_USER_ID=U01234567
ALLOWED_CHANNEL_IDS=C01234567,C07654321

# Optional overrides
PRIMARY_MODEL=openai/gpt-5.6-luna
FALLBACK_MODEL=google/gemini-3.7-flash
LOADING_STATUS_MODEL=google/gemini-2.5-flash-lite
DIRECTIVE_POLICY_MODEL=openai/gpt-5.6-luna
IMAGE_GENERATION_MODEL=google/gemini-3.1-flash-lite-image
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault
# Configure each local media service as a URL/API-key pair. Omit both lines to disable one.
# SONARR_URL=http://127.0.0.1:8989
# SONARR_API_KEY=replace-me
# RADARR_URL=http://127.0.0.1:7878
# RADARR_API_KEY=replace-me
# SABNZBD_URL=http://127.0.0.1:8080
# SABNZBD_API_KEY=replace-me
# Optional: lets the owner run explicitly confirmed SSH commands on named machines.
# One JSON object on a single line, keyed by lowercase alias. port defaults to 22;
# keyPath defaults to ssh's normal identity resolution (agent/default keys) when omitted.
# SSH_HOSTS_JSON={"nas":{"host":"192.168.1.10","user":"matt","keyPath":"/Users/matt/.ssh/id_ed25519_nas"}}
DEFAULT_TIMEZONE=America/New_York
LOG_LEVEL=info
# Optional data location override. Linux defaults to ~/.local/share/figai.
# FIGAI_DATA_DIR=/absolute/path/to/figai-data
