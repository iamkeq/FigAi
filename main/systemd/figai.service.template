[Unit]
Description=FigAi local Slack assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="__EXECUTABLE__"
WorkingDirectory="__WORKING_DIRECTORY__"
Environment="FIGAI_ENV_PATH=__ENV_PATH__"
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
